# Maintainer: Nitya Naman <me@ciderboi.xyz>

pkgname=vizdial
pkgver=0.1.0
pkgrel=1
pkgdesc='Frosted 120 FPS OpenGL radial audio visualizer with 5-zone logarithmic FFTW DSP'
arch=('x86_64' 'aarch64')
url='https://github.com/namanyt/vizdial'
license=('GPL-3.0-or-later')
depends=(
  'fftw'
  'hicolor-icon-theme'
  'kwindowsystem'
  'libglvnd'
  'libpulse'
  'qt6-base'
  'qt6-wayland'
)
makedepends=(
  'cmake'
  'pkgconf'
)
optdepends=(
  'pipewire-pulse: recommended PipeWire monitor capture backend'
  'cava: automatic Matugen Cava theme sync'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('ba0e008ef5ded5e71bbbec1d6a628f9a6a90c87126adda1e1398213c71ab0e0a')

build() {
  cmake -B build -S "${pkgname}-${pkgver}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build -j"$(nproc)"
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
